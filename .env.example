# =============================================================================
# Cognitive Knowledge Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM Provider (Primary: Gemini Free Tier) ---
GOOGLE_API_KEY=your-gemini-api-key-here
DEFAULT_MODEL=gemini-2.5-flash

# --- LLM Provider (Fallback: Ollama Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Qdrant (Vector Store) ---
QDRANT_URL=http://localhost:6333
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# --- PostgreSQL (Tabular / Relational Store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ckp_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ckp_db

# --- Embedding Model (Local, Free) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- AI Gateway Settings ---
GATEWAY_DEFAULT_TPM=100000
GATEWAY_DEFAULT_RPM=60
GATEWAY_DEFAULT_TPD=1000000
GATEWAY_DEFAULT_RPD=5000
GATEWAY_MAX_BUDGET_USD=10.0
GATEWAY_BUDGET_PERIOD_DAYS=30

# --- Guardrails Settings ---
GUARDRAILS_ENABLE_PII_MASKING=true
GUARDRAILS_ACTIVE_DOMAIN=healthtech
GUARDRAILS_ENFORCE_READ_ONLY=true
GUARDRAILS_CHECK_GROUNDEDNESS=true

# --- Agent Harness Settings ---
AGENT_MAX_STEPS=10
AGENT_ENABLE_REFLECTION=true
AGENT_ENABLE_MEMORY=true

# --- Platform App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# --- Active Ontology Schema ---
ACTIVE_SCHEMA=healthtech
